# --- Meta / WhatsApp Cloud API ---
# Cadena aleatoria que inventas tu. Debe coincidir con la que registres
# en el panel de Meta al configurar el webhook.
META_VERIFY_TOKEN=
# developers.facebook.com -> app -> Configuracion de la app -> Basica
META_APP_SECRET=
# Token del usuario del sistema (caducidad "Nunca"), NO el del panel.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v25.0

# --- Identidad y cifrado ---
# CRITICOS E IRRECUPERABLES. Guarde una copia FUERA de este equipo.
#
# Si PHONE_HASH_PEPPER cambia o se pierde, las huellas guardadas dejan de
# coincidir y TODAS las usuarias registradas dejan de ser reconocidas.
# Si NAME_ENCRYPTION_KEY se pierde, los nombres cifrados no se recuperan.
# No hay forma de deshacer ninguna de las dos cosas.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_PEPPER=
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
NAME_ENCRYPTION_KEY=

# --- Gemini ---
# https://aistudio.google.com/apikey
# La misma clave sirve para los embeddings y para el agente.
GEMINI_API_KEY=
# Modelo generativo (agente, extraccion, redaccion del RAG). Opcional: si
# se deja vacio se usa el valor por defecto de app/config.py.
# Se puede cambiar en Railway sin desplegar.
#
# Cuidado: gemini-2.5-flash se retira el 16/10/2026. Use la serie 3.
#
# El modelo de EMBEDDINGS no esta aqui a proposito. Cambiarlo invalida
# todos los vectores guardados y obliga a re-vectorizar, asi que vive como
# constante en app/core/gemini.py (ADR-0007).
GEMINI_GENERATIVE_MODEL=gemini-3.6-flash

# --- Recuperacion (RAG) ---
# Opcionales: si se dejan vacios valen los de app/config.py. Se pueden
# cambiar en Railway sin desplegar, que es lo que la calibracion de la
# Fase 7 va a necesitar. Cambiarlos NO invalida nada de lo guardado, al
# contrario que el modelo de embeddings.
#
# Es una SIMILITUD coseno (0 a 1), no una distancia. Escribir una distancia
# aqui invierte el filtro sin dar ningun error.
#
# 0.68 y no el 0.70 de la Fase 4: medido contra el corpus real, 0.70 deja
# sin respuesta 4 de cada 12 consultas legitimas del CU2 (ADR-0010).
RAG_UMBRAL_SIMILITUD=0.68
RAG_TOP_K=4

# La coleccion comunitaria lleva umbral propio, y no por simetria: sus
# fragmentos son listas de tres palabras ("tomate, cilantro, lechuga"), no
# prosa de 400 tokens, asi que sus similitudes viven en otro rango. Con el
# de arriba, la consulta mas tipica del CU4 se quedaba sin respuesta
# (ADR-0011).
RAG_UMBRAL_COMUNITARIO=0.65

# Cuando ninguna fuente oficial supera el umbral, el CU2 responde con el
# conocimiento del modelo: sin citar nada y solo si la pregunta es de
# huertas. Es el tercer nivel de la jerarquia de CLAUDE.md §6, que el
# ADR-0010 habia decidido no usar aqui.
#
# Es el interruptor de vuelta atras: con `false` se recupera el
# comportamiento anterior —texto fijo— sin desplegar y sin tocar codigo.
CU2_RESPALDO_MODELO=true

# --- Memoria de conversacion ---
# Cuantos mensajes de lo ya hablado ve el agente. Se cuentan mensajes, no
# turnos: 10 son unos cinco intercambios, y el ultimo es el que la usuaria
# acaba de escribir. Opcional, como los de arriba (ADR-0012).
MEMORIA_VENTANA_MENSAJES=10

# --- Supabase ---
# Panel de Supabase -> Connect -> Session pooler.
# TIENE que ser el session pooler (pooler.supabase.com:5432):
#   - la conexion directa (db.<ref>.supabase.co) es solo IPv6 sin el
#     complemento IPv4 de pago;
#   - el transaction pooler (puerto 6543) no admite prepared statements
#     y rompe asyncpg.
DATABASE_URL=

LOG_LEVEL=INFO
